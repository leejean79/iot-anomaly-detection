# ============================================================================
# FA-iForest 集群部署 — 环境变量
# Cluster deployment environment variables
# ============================================================================
# 用法 / Usage:
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 按实际阿里云内网 IP 填写 NODE_*_IP
#   3. 所有脚本(0-prepare-local.sh / 1-sync-to-nodes.sh 等)会自动 source .env
#
# 重要 / Important:
#   - NODE_*_IP 必须填阿里云"内网 IP"(同 VPC 内通信免流量费), 不是公网 IP
#   - SSH_USER 必须能免密 sudo, 或者用 root (省事但有安全风险)
# ============================================================================

# ---------- 节点拓扑 / Node topology ----------
# 3 节点最小集群: master 跑 ZK + Kafka broker-1 + Flink JM + Prom + Grafana
#                worker 跑 Kafka broker-N + Flink TM
NODE_MASTER_IP=172.16.0.11
NODE_WORKER1_IP=172.16.0.12
NODE_WORKER2_IP=172.16.0.13

# 节点公网 IP(仅用于本地 ssh 跳板), 阿里云 ECS 默认会有一个弹性公网
NODE_MASTER_PUBLIC_IP=
NODE_WORKER1_PUBLIC_IP=
NODE_WORKER2_PUBLIC_IP=

# SSH 用户(本地 → 节点), 需要免密登录 + sudo 权限
SSH_USER=root
SSH_KEY=~/.ssh/id_rsa

# ---------- 组件版本 / Component versions ----------
# 严格对齐项目 pom.xml: Flink 1.13.6 + Kafka 2.6.3
ZK_VERSION=3.6.3
KAFKA_VERSION=2.6.3
KAFKA_SCALA_VERSION=2.12
FLINK_VERSION=1.13.6
FLINK_SCALA_VERSION=2.12
JDK_BASE_IMAGE=eclipse-temurin:8-jre-jammy

# ---------- 远端工作目录 / Remote working directory ----------
# 所有 docker-compose / jar / 数据集落到这个目录(各节点一致)
REMOTE_HOME=/opt/fa-iforest

# ---------- Flink 资源 / Flink resources ----------
# JobManager: 1 个, 在 master 节点
JM_HEAP_MB=1024
# TaskManager: 每节点 1 个, slots 数 = 节点 CPU 数(worker 4c 即 slots=4)
TM_SLOTS=4
TM_HEAP_MB=4096
TM_MANAGED_MEM_MB=1024

# ---------- Kafka 资源 / Kafka resources ----------
KAFKA_HEAP_OPTS="-Xms512m -Xmx1024m"

# ---------- Topic 设计 / Topic design ----------
# 这 6 个名字来自代码 (LocalProcessor / CoordinatorJob 的 default), 不要乱改 --
# 改了的话, 必须同时改两个 Java main 类的默认值, 或者每次 submit job 都传 --xxxTopic.
# 方向二(a) Phase 3 之后:
#   - drift-topic (DriftReport) 已废,被 feature-drift-topic (FeatureDrift) 取代
#   - source-topic 单独有 SOURCE_PARTITIONS (Fork 1 = 1,保 per-feature 顺序;
#     Fork 2/EXP3 升 P_d 个 partition 才接多 sender 交织)
#   - tree-topic / model-topic / feature-drift-topic / drift-round-topic 都是协议性 topic, 量不大
#   - output-scores 是结果落盘, Phase 1 不追求高吞吐
#   - 后续要扩并行: kafka-topics.sh --alter --partitions N (随时改, 不是单向门)
TOPIC_SOURCE=source-topic
TOPIC_TREE=tree-topic
TOPIC_MODEL=model-topic
TOPIC_SCORE=output-scores
TOPIC_FEATURE_DRIFT=feature-drift-topic
TOPIC_DRIFT_ROUND=drift-round-topic

# 所有 topic 统一 partition / replication
TOPIC_PARTITIONS=1
TOPIC_REPLICATION=2
# source-topic 单独的 partition (Fork 1 v1 = 1;Fork 2/EXP3 升 P_d)
SOURCE_PARTITIONS=1

# ---------- 监控 / Monitoring (可选, 推荐) ----------
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ---------- Job 配置 / Job submission ----------
JOB_JAR_NAME=FA-iForest-1.0-SNAPSHOT.jar

# 两个 Flink Job (代码里分别是 main 类)
JOB_LOCAL_MAIN=com.leejean.main.LocalProcessor
JOB_COORDINATOR_MAIN=com.leejean.main.CoordinatorJob

# 并行度: Coordinator 内部强制 setParallelism(1), 这里写 1 保持一致
# LocalProcessor 用 8 (= 2 worker x 4 slot)
JOB_LOCAL_PARALLELISM=8
JOB_COORDINATOR_PARALLELISM=1

# LocalProcessor 模型参数 (代码 default 对齐)
JOB_TOTAL_TREES=100
JOB_SUBSAMPLE_SIZE=256
JOB_RING_BUFFER_SIZE=1000

# CoordinatorJob 投票超时 (代码 default 5000ms)
JOB_VOTING_TIMEOUT_MS=5000

# 检测面参数 (方向二(a) Phase 3),暂用 LocalProcessor 代码 default, 以后调参再加在这里 /
# Detection-side params: use code defaults for now, add here when tuning later.
#   LocalProcessor:  --iksWindowSize --iksPValue --confirmWin --ksConfirm
#                    --detectionParallelism --cooldownSamples --zThresholdK --pauseMode
#   CoordinatorJob:  --aggK --aggWin --refractory

# ============================================================================
# SYN_* 增量段 / SYN_* additions (本项目 iot-anomaly-detection, ENV 阶段 DEV-D8/D9)
# ============================================================================
# 与旧项目共存 / Coexistence with the old project:
#   - 旧变量段（TOPIC_* / SOURCE_PARTITIONS / JOB_* 等）原样保留，供旧脚本复用；
#     the old variable block above is kept verbatim so the old scripts still run.
#   - 本项目所有新增变量一律以 SYN_ 前缀追加于此，绝不覆盖同名旧变量；
#     every new variable is SYN_-prefixed and appended here; no old variable is overwritten.
#   - REMOTE_HOME 保持 /opt/fa-iforest 不变：集群侧目录归旧基础设施（jobmanager 容器
#     已固化挂载 /opt/fa-iforest/jars），本项目 jar/数据集以文件名区分（iot-anomaly-detection-*）。
#     REMOTE_HOME stays /opt/fa-iforest; cluster-side dirs belong to the old infra, this
#     project's artifacts are distinguished by filename (iot-anomaly-detection-*).
#
# 缩写自查 / Abbreviations:
#   RF   = Replication Factor 副本因子（每分区数据副本份数）
#   ms   = milliseconds 毫秒
#   retention = topic 消息保留时长（到期后 Kafka 自动删除旧消息）
# ----------------------------------------------------------------------------

# ---------- 新 topic 名称 / new topic names ----------
SYN_TOPIC_SOURCE=synergia-source
SYN_TOPIC_SMOKE=synergia-smoke

# ---------- 主数据流分区与副本 / main-stream partitions and replication ----------
# 8 分区：对应 DeviceId A–H 的"一设备一分区"目标语义（M1 重放器用显式 partitioner 落地；
# 本阶段冒烟用 console 工具按默认 hash(key)%partitions，允许碰撞）。
# 8 partitions map to the eight DeviceIds A-H (explicit partitioner in the M1 replayer;
# this stage's smoke test uses the console tools with the default hash partitioner).
SYN_SOURCE_PARTITIONS=8
# RF=2：集群实测存活 broker [1,2,3] 三台，RF=2 兼顾容错与磁盘（三节点各约 28 GB）。
# RF=2: three live brokers [1,2,3]; RF=2 balances fault tolerance against disk.
SYN_TOPIC_REPLICATION=2
# 关闭基于时间的保留（retention.ms=-1，永久保留，靠 syn-clean-topics 手动清理）。
# 【为何必须 -1，血泪教训】重放器给 source、M1Job 给 m1-out/monitoring 的消息都显式盖**事件时间**
#   时间戳（如 2022-05-21，CreateTime）。Kafka 的时间保留按消息自带时间戳算年龄，故在"今天"看这些
#   2022 的消息全部超期，写进去几分钟内即被删——末端偏移量还在（历史计数），但日志段被清空，
#   `--from-beginning` 一条读不到，导致 V-M1-3/-4 无法离线消费 m1-out/monitoring，source 也无法事后重读。
#   事件时间盖在消息上是**有意设计**（M1Job 及下游 M2 靠 kafka 记录时间戳取事件时间做 watermark），
#   不能改时间戳、也不能用 LogAppendTime（会覆盖事件时间）。正解是关时间保留、实验间用
#   syn-clean-topics.sh 显式删+重建来隔离。磁盘兜底：全集一轮 source≈5GB、m1-out≈5–10GB（RF2 翻倍），
#   三节点各约 28GB，单轮 + 实验间清理够用；若跑多轮不清理需留意磁盘，必要时对个别 topic 改用 retention.bytes。
# Disable time-based retention (retention.ms=-1); rely on syn-clean-topics for inter-run cleanup.
# WHY -1: records carry **event-time** timestamps (e.g. 2022-05-21, CreateTime) set by the replayer
#   (source) and by M1Job (m1-out/monitoring). Kafka ages messages by their own timestamp, so these
#   2022 messages are "expired" today and get deleted minutes after being written — the end offset
#   remains but the log segments are emptied, so `--from-beginning` reads nothing and offline
#   consumption for V-M1-3/-4 is impossible. Event-time on the wire is intentional (M1Job and the
#   downstream M2 derive event time from the Kafka record timestamp), so we fix retention, not the
#   timestamp (LogAppendTime would overwrite event time and break that). Cleanup stays manual.
SYN_RETENTION_MS=-1

# ---------- M1 阶段扩展的输出/监测 topic 清单（参数化，M1 只改清单不改脚本）----------
# M1's output/monitoring topics (parameterised list; M1 edits the list, not the script).
# 格式 / format: 逗号分隔的 "name:partitions" 项；留空表示本阶段不建额外 topic。
# comma-separated "name:partitions" items; empty means no extra topics this stage.
# 注意 / NOTE: 含逗号的值**必须加引号**（.env 由 `source` 读取，未加引号的空格/逗号会解析出错）。
#              Quote the value (it is read by `source`; unquoted spaces/commas break parsing).
# M1 阶段 topic（交接文档 §2.2）/ M1-stage topics (handover §2.2):
#   synergia-scores(4)      检测分数流（M2/M3 用，M1 预建）/ detection scores (pre-provisioned)
#   synergia-monitoring(1)  M1 逐设备逐 60s 监测快照 / per-device 60s monitoring snapshots
#   synergia-m1-out(1)      M1 归一化 DeviceRound（仅验收用，临时）/ normalized rounds (acceptance only)
SYN_EXTRA_TOPICS="synergia-scores:4,synergia-monitoring:1,synergia-m1-out:1"

# ---------- Job 提交占位（M1 填写）/ job-submission placeholders (M1 fills in) ----------
# M1 已交付 / filled by M1. 集群侧仍落 /opt/fa-iforest/jars，文件名以 iot-anomaly-detection- 起头
# 以与 FA-iForest-*.jar 区分。/ jar lands in /opt/fa-iforest/jars; name starts with iot-anomaly-detection-.
SYN_JOB_JAR_NAME=iot-anomaly-detection-1.0-SNAPSHOT.jar
# M1 Flink 作业入口 / M1 Flink job entry point
SYN_JOB_MAIN=com.leejean.m1.M1Job
# 数据集在集群侧的路径（DEV-D8：沿用旧挂载 /opt/fa-iforest）/ dataset path on the cluster
SYN_DATASET_DIR=/opt/fa-iforest/datasets/synergia/files_csv
# CsvKafkaReplayer 入口 / replayer entry point
SYN_REPLAYER_MAIN=com.leejean.source.CsvKafkaReplayer
# 重放器断点续跑 offset 的宿主目录（必须可写；数据集目录 root 拥有，而容器降权到 uid 9999 写不进，
# 故单独用此目录并 chmod 777 挂为 /state）。/ host dir for the replayer resume offset (must be writable;
# the dataset dir is root-owned and the container runs as uid 9999, so use a separate chmod-777 dir).
SYN_REPLAY_STATE_DIR=/opt/fa-iforest/replay-state

# ---------- M2 阶段（pMCOD 点异常检测）/ M2 stage (pMCOD point-anomaly detection) ----------
# M2 联合作业入口（M1 段复用 + pMCOD）/ M2 joint job entry point (M1 stage reused + pMCOD)
SYN_M2_JOB_MAIN=com.leejean.m2.M2Job
# 离线 (R,k) 校准探针入口 / offline (R,k) calibration probe entry point
SYN_M2_PROBE_MAIN=com.leejean.m2.M2Probe
# 事件时间滑动窗口：窗长 W / 滑动步 S（占位默认，§4）/ sliding window W / S (placeholder defaults)
SYN_M2_WINDOW_SEC=3600
SYN_M2_SLIDE_SEC=60
# MCOD 全局参数（逐设备 R 未覆盖的设备回退到 SYN_M2_R；k 已定稿为 10）/ global MCOD params (fallback R; k)
SYN_M2_R=1.0
SYN_M2_K=10
# 逐设备半径 R（收尾任务一标定 + 设计会话裁决 + 延伸补测）：
#   已定稿 6 台：A=B=H=1.0（安静档，避开网格边界、留余量）、E=G=0.75（落带内，平手取较小 R）、
#              F=2.25（延伸补测落带中心 0.316%，按裁决 3 预授权定稿）；
#   临时 2 台：C=D=1.75（过度活跃，诊断出根因是 Light 通道重尾放大、非整体更动态；终值待设计会话在
#              通道/标准化层面处置后再定；任务二先用临时值跑，见 m2_rk_calibration.md 补测结果段）。
# Per-device radius R: A/B/H=1.0, E/G=0.75, F=2.25 final; C/D=1.75 temporary (root cause = Light-channel tail).
SYN_M2_R_PER_DEVICE="A=1.0,B=1.0,C=1.75,D=1.75,E=0.75,F=2.25,G=0.75,H=1.0"
# 探针网格 / probe grid（§7）
SYN_M2_PROBE_R_GRID="0.5,1.0,1.5,2.0,2.5,3.0"
SYN_M2_PROBE_K_GRID="5,10,20"
