<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  iot-anomaly-detection —— IoT/PMU 流式异常检测系统 Maven 基座
  IoT/PMU streaming anomaly-detection system — Maven base POM
  ============================================================================
  说明 / Notes（ENV 阶段 DEV-D9）:
    - 本 POM 自 FA-iForest-master fork（groupId 同为 com.leejean）。
      Forked from FA-iForest-master (same groupId com.leejean).
    - 相对旧 POM 的改动仅两类 / only two kinds of change vs the old POM:
        (a) 坐标改名 / coordinates renamed:
              artifactId  FA-iForest → iot-anomaly-detection
        (b) 裁剪 flink-table / flink-avro 依赖（本项目不用 Table API / Avro）
              trimmed the flink-table-* and flink-avro dependencies (unused here).
    - 保留项（资产清单，勿动）/ preserved assets (do not touch):
        Smile 的 Kotlin 全排除、dependencyManagement 钉版、maven-shade 配置、
        log4j2 / JUnit5 / Guava / Jackson。
        Smile's blanket Kotlin exclusion, the dependencyManagement version pins,
        the maven-shade configuration, and log4j2 / JUnit5 / Guava / Jackson.
    - 版本严格对齐集群 / versions strictly aligned with the cluster:
        Flink 1.13.6 (Scala 2.12) + Kafka 2.6.3 + JDK 8。
    - 本阶段 src/ 为空包架子，无业务代码；`mvn clean package` 应产出
      iot-anomaly-detection-1.0-SNAPSHOT.jar（shade 链路自证，jar 内无业务类属正常）。
      This stage ships an empty source skeleton; `mvn clean package` must still produce
      iot-anomaly-detection-1.0-SNAPSHOT.jar (a jar with no business classes is expected).
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.leejean</groupId>
    <artifactId>iot-anomaly-detection</artifactId>
    <version>1.0-SNAPSHOT</version>


    <properties>
        <flink.version>1.13.6</flink.version>
        <scala.binary.version>2.12</scala.binary.version>
        <!-- 运行时/构建基线自 2026-09 起为 Java 11（Java 11 迁移 Addendum 2）：集群运行时切到
             flink:1.13.6-scala_2.12-java11，编译按 release 11。Flink 仍 1.13.6、Kafka 仍 2.6.3、Scala 仍 2.12。
             Runtime/build baseline is Java 11 as of 2026-09 (Java-11 migration Addendum 2). -->
        <java.version>11</java.version>
        <maven.compiler.release>11</maven.compiler.release>
        <kafka.version>2.6.3</kafka.version>
        <kotlin.version>1.4.32</kotlin.version>
        <!-- DL4J/ND4J 回到 1.0.0-M2.1（Java 11 字节码，主版本 55）：集群已迁到 Java 11，可正常加载。
             DL4J/ND4J back to 1.0.0-M2.1 (Java 11 bytecode, major 55): loadable now that the cluster is Java 11. -->
        <dl4j.version>1.0.0-M2.1</dl4j.version>
        <!-- 仅解析 linux-x86_64 原生库，避免 bytedeco 多平台原生库进 fat jar（Addendum 2 §2.2）。
             Resolve only linux-x86_64 natives to keep bytedeco multi-platform binaries out of the fat jar. -->
        <javacpp.platform>linux-x86_64</javacpp.platform>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 强制指定 Kotlin 版本，解决版本冲突 / pin Kotlin to resolve version conflicts -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-common</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk7</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-reflect</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <!-- DL4J / ND4J 传递依赖钉版，防止与 Flink 的内部 Jackson / Protobuf 冲突
                 Pin DL4J/ND4J transitive deps to prevent clashes with Flink internals -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.13.5</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.13.5</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.13.5</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>3.21.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- =========================== Flink 核心 / Flink core =========================== -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-java</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java_${scala.binary.version}</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients_${scala.binary.version}</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <!-- 本地 Web UI / local web dashboard (harmless on cluster, useful for local runs) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-runtime-web_${scala.binary.version}</artifactId>
            <version>${flink.version}</version>
        </dependency>

        <!-- 裁剪说明 / TRIMMED (ENV 阶段 DEV-D9): 本项目不使用 Flink Table API 与 Avro，
             故移除 flink-table-api-java、flink-table-api-java-bridge、flink-table-planner-blink、
             flink-avro。M1 若确需可在此重新引入。
             This project uses neither the Flink Table API nor Avro, so the four artifacts above
             were removed. M1 may re-add them here if genuinely required. -->

        <!-- =========================== 机器学习 / ML libraries =========================== -->
        <!-- smile-core 2.6.0：排除全部 Kotlin 依赖（与 dependencyManagement 钉版配套） -->
        <dependency>
            <groupId>com.github.haifengl</groupId>
            <artifactId>smile-core</artifactId>
            <version>2.6.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.edwardraff</groupId>
            <artifactId>JSAT</artifactId>
            <version>0.0.9</version>
        </dependency>

        <!-- ===================== 深度学习 / Deep Learning (M3, DEV-D1) ============ -->
        <!-- DL4J 核心（LSTM 自编码器训练与推断）
             DL4J core — LSTM autoencoder training and inference -->
        <dependency>
            <groupId>org.deeplearning4j</groupId>
            <artifactId>deeplearning4j-nn</artifactId>
            <version>${dl4j.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- ND4J 原生后端（CPU，linux-x86_64；集群与本开发环境均为 Linux）
             ND4J native backend (CPU, linux-x86_64; both cluster and dev env are Linux) -->
        <dependency>
            <groupId>org.nd4j</groupId>
            <artifactId>nd4j-native</artifactId>
            <version>${dl4j.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.nd4j</groupId>
            <artifactId>nd4j-native</artifactId>
            <version>${dl4j.version}</version>
            <classifier>linux-x86_64</classifier>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- =========================== Kafka connector =========================== -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka_${scala.binary.version}</artifactId>
            <version>${flink.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- =========================== JSON =========================== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.5</version>
        </dependency>

        <!-- =========================== 日志 / Logging (log4j2, 与 log4j2.properties 配套) === -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.17.2</version>
        </dependency>

        <!-- =========================== 工具 / Utilities =========================== -->
        <!-- Google Guava (RateLimiter 限流器等) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.2-jre</version>
        </dependency>

        <!-- =========================== 测试 / Testing =========================== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.3</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <!-- release 11 单一开关，避免与 source/target 冲突 / single release switch -->
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!-- 守卫：构建 JDK 必须是 11.x；任何依赖字节码不得高于 Java 11。若某依赖违反字节码规则，
                 回报设计会，绝不改用更高版本 JDK 绕过（Addendum 2 §2.1 / §7）。
                 Guards: the build JDK must be 11.x; no dependency's bytecode may exceed Java 11. A
                 violation is reported to the design session, never worked around on a newer JDK. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.7.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-java-and-bytecode</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[11,12)</version>
                                </requireJavaVersion>
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>11</maxJdkVersion>
                                </enforceBytecodeVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
